{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull 2>/dev/null || true",
            "statusMessage": "Синхронизация с GitHub..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git push 2>/dev/null || true",
            "if": "Bash(git commit *)",
            "statusMessage": "Отправка в GitHub..."
          }
        ]
      }
    ]
  }
}
